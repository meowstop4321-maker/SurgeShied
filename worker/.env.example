# Worker environment variables. Copy to worker/.env and fill in.

# Required — same Supabase project as the edge functions.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required — must be the EXACT same value configured in
# supabase/.env.secrets so tokens the worker issues verify against what
# surge-router/register.ts expect (and vice versa).
SEAT_PASSPORT_SECRET=

# Optional — omit to run in simulated-email mode (logs "would have sent"
# instead of calling Resend; useful for local dev / demos without burning
# real send quota).
RESEND_API_KEY=
RESEND_FROM=SurgeShield <onboarding@resend.dev>

# Optional — shared secret Pub/Sub's push subscription must present as
# ?token=... on /pubsub/notification-jobs. Invent any string; setup-pubsub.sh
# and deploy-worker.sh share it via scripts/.demo-state.
PUBSUB_PUSH_TOKEN=

# Optional — bearer/x-worker-secret token required for the admin routes
# (/jobs/status, /jobs/enqueue, /manager/scale, /lanes/rebalance). If unset,
# SUPABASE_SERVICE_ROLE_KEY or PUBSUB_PUSH_TOKEN also work as valid tokens.
# Leave ALL three (this, service role, pubsub token) unset only for local dev
# — with no valid tokens configured, requireWorkerAuth() allows any caller.
WORKER_SECRET=

# Optional — port the worker's HTTP server listens on. Defaults to 8080.
PORT=8080
